      {
        "type": "color",
        "id": "accent_1",
        "label": "Akzent 1 kräftig",
        "default": "#62A7FD"
      },
      {
        "type": "color",
        "id": "accent_1_deep",
        "label": "Akzent 1 tief (Links auf hellem Grund)",
        "default": "#3464A0"
      },
      {
        "type": "color",
        "id": "accent_1_light",
        "label": "Akzent 1 hell (Flächen)",
        "default": "#EDF5FF"
      },
      {
        "type": "color",
        "id": "accent_2",
        "label": "Akzent 2 kräftig",
        "default": "#DD9225"
