  {
    "name": "Theme-Vorschau",
    "settings": [
      {
        "type": "paragraph",
        "content": "Die Vorschau liest pro Variante die Metafelder theme.screenshot_desktop und theme.screenshot_mobile (Bilder) sowie theme.farbe_grund und theme.farbe_akzent (Farben). Pro Produkt: theme.branche, theme.passt_fuer, theme.sektionen und theme.sprungmarken."
      },
      {
        "type": "textarea",
        "id": "preview_outline",
        "label": "Sektionen im Platzhalter",
