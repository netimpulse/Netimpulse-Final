{%- comment -%} Über uns: Wer dahintersteht. Einleitung und Teammitglieder mit Foto oder Initial. {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom, selector: '.about-team' -%}

<section class="about-team {% render 'scheme-classes', scheme: s.color_scheme %}{% if s.dots %} dots-bg{% endif %}" id="s-{{ section.id }}" data-outline="{{ s.outline_label | escape }}" {% if s.heading != blank %}aria-labelledby="team-title-{{ section.id }}"{% endif %}>
  <div class="wrap">
    <div class="about-team-head">
      {%- if s.heading != blank -%}<h2 id="team-title-{{ section.id }}" class="about-team-title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.lead != blank -%}<p class="about-team-lead">{{ s.lead }}</p>{%- endif -%}
      {%- if s.text != blank -%}<p class="about-team-text">{{ s.text }}</p>{%- endif -%}
    </div>
    <ul class="team-full" role="list">
      {%- for block in section.blocks -%}
        <li class="member" {{ block.shopify_attributes }}>
          {%- render 'portrait', name: block.settings.name, image: block.settings.image, large: true -%}
          <div>
            <h3 class="member-name">{{ block.settings.name }}</h3>
            <p class="member-role">{{ block.settings.role }}{% if block.settings.focus != blank %} · {{ block.settings.focus }}{% endif %}</p>
            <p class="member-text">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Team",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "checkbox", "id": "dots", "label": "Punktraster im Hintergrund", "default": false },
    { "type": "text", "id": "outline_label", "label": "Name in der Sektions-Gliederung", "default": "Team" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wer dahintersteht" },
    { "type": "textarea", "id": "lead", "label": "Einleitung", "default": "Bei NetImpulse geht es nicht darum, irgendwas Hübsches ins Internet zu stellen und zu hoffen, dass es schon läuft." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Keine anonyme Agenturstruktur: Du sollst wissen, mit wem du arbeitest." },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 100 }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Person",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Niklas" },
        { "type": "text", "id": "role", "label": "Rolle", "default": "Gründer und Geschäftsführer" },
        { "type": "text", "id": "focus", "label": "Schwerpunkt", "default": "Online-Marketing und Shopify-Entwicklung" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sorgt dafür, dass eine Website nicht nur gut aussieht, sondern auch gefunden wird und etwas bringt." },
        { "type": "image_picker", "id": "image", "label": "Foto", "info": "Ohne Foto wird der Anfangsbuchstabe gezeigt." }
      ]
    }
  ],
  "presets": [{ "name": "Team", "blocks": [{ "type": "member" }] }]
}
{% endschema %}
