    },
    {
      "type": "text",
      "id": "label_name",
      "label": "t:sections.contact_form.settings.label_name.label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "t:sections.contact_form.settings.label_email.label",
