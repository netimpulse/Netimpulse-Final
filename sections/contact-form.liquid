    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header_1.content",
      "info": "t:sections.contact_form.settings.header_1.info"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "t:sections.contact_form.settings.phone_label.label",
      "default": "Telefon"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "t:sections.contact_form.settings.email_label.label",
      "default": "E-Mail"
    },
    {
      "type": "text",
      "id": "address_label",
      "label": "t:sections.contact_form.settings.address_label.label",
      "default": "Adresse"
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header_2.content"
    },
    {
      "type": "text",
      "id": "form_label",
