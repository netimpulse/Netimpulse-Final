    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "t:sections.contact_form.settings.label_phone.label",
      "default": "Telefon"
    },
    {
      "type": "text",
      "id": "label_company",
      "label": "t:sections.contact_form.settings.label_company.label",
