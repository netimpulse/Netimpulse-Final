      "default": "Wir melden uns innerhalb von 48 Stunden mit klaren nächsten Schritten."
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.settings.header_4.content"
    },
    {
      "type": "range",
      "id": "padding_top",
