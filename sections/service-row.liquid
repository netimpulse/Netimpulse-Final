{%- comment -%}
  Ein Leistungsblock der Leistungsübersicht: großer Name, Untertitel, Partner-Leistungen, Text, Punkte, Buttons.
  Sprungziel: l-<kennung>, passend zum Rad und zur Leiste im Kopf.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign points = s.points | newline_to_br | split: '<br />'
  assign partners = s.partners | split: ','
  capture contact_url
    render 'contact-url'
  endcapture
-%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom, tablet: 80, mobile: 64 -%}

<section
  id="l-{{ s.key | handleize }}"
  data-outline="{{ s.name | escape }}"
  class="chapter l-ch section-pad {% render 'scheme-classes', scheme: s.color_scheme %}{% if s.dots %} dots-bg{% endif %}"
  aria-labelledby="lt-{{ section.id }}"
>
  <div class="wrap">
    <div class="l-row{% render 'group-class', group: s.group %}">
      <div class="l-head">
        <h2 id="lt-{{ section.id }}" class="l-name"><i class="svc-dot" aria-hidden="true"></i>{{ s.name }}</h2>
        {%- if s.subtitle != blank -%}<p class="l-sub">{{ s.subtitle }}</p>{%- endif -%}
        {%- if s.partners != blank -%}
          <div class="l-pairs">
            {%- if s.partners_label != blank -%}<span>{{ s.partners_label }}</span>{%- endif -%}
            {%- for p in partners -%}
              {%- assign pair = p | split: '=' -%}
              {%- assign label = pair.first | strip -%}
              {%- assign target = pair.last | strip | handleize -%}
              <button type="button" data-scroll-to="l-{{ target }}">{{ label }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      <div class="l-body">
        {%- if s.text != blank -%}<p class="l-text">{{ s.text }}</p>{%- endif -%}
        <ul class="checklist" role="list">
          {%- for pt in points -%}
            {%- assign t = pt | strip -%}
            {%- if t != blank -%}<li>{%- render 'icon', name: 'check', size: 16 -%}<span>{{ t }}</span></li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="actions">
          {%- if s.button_label != blank -%}
            <a href="{{ s.button_link | default: '#' }}" class="btn btn-primary"><span>{{ s.button_label }}</span>{%- render 'icon', name: 'arrow-right' -%}</a>
          {%- endif -%}
          {%- if s.link_label != blank -%}
            <a href="{{ s.link | default: contact_url }}" class="arrow-link"><span>{{ s.link_label }}</span>{%- render 'icon', name: 'arrow-right', size: 16 -%}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.service_row.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "t:general.dots.label",
      "default": false
    },
    {
      "type": "select",
      "id": "group",
      "label": "t:general.group.label",
      "default": "a1",
      "options": [
        {
          "value": "a1",
          "label": "t:general.groups.a1"
        },
        {
          "value": "a2",
          "label": "t:general.groups.a2"
        }
      ]
    },
    {
      "type": "text",
      "id": "key",
      "label": "t:sections.service_row.settings.key.label",
      "info": "t:sections.service_row.settings.key.info",
      "default": "seo"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:sections.service_row.settings.name.label",
      "default": "SEO"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:sections.service_row.settings.subtitle.label",
      "default": "Gefunden werden, bevor andere sichtbar sind"
    },
    {
      "type": "text",
      "id": "partners_label",
      "label": "t:sections.service_row.settings.partners_label.label",
      "default": "Arbeitet zusammen mit"
    },
    {
      "type": "text",
      "id": "partners",
      "label": "t:sections.service_row.settings.partners.label",
      "info": "t:sections.service_row.settings.partners.info",
      "default": "GEO = geo, Webdesign = webdesign"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.service_row.settings.text.label",
      "default": "Damit deine Website gefunden wird, braucht es mehr als ein paar Keywords."
    },
    {
      "type": "textarea",
      "id": "points",
      "label": "t:sections.service_row.settings.points.label",
      "info": "t:sections.service_row.settings.points.info",
      "default": "Keyword- und Seitenstruktur mit klarer Suchintention\nTechnische SEO-Grundlagen für Performance und Indexierung"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.service_row.settings.button_label.label",
      "default": "Mehr zu SEO"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.service_row.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.service_row.settings.link_label.label",
      "default": "Projekt anfragen"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.service_row.settings.link.label",
      "info": "t:sections.service_row.settings.link.info"
    },
    {
      "type": "header",
      "content": "t:sections.service_row.settings.header_1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "t:sections.service_row.presets.name"
    }
  ]
}
{% endschema %}
