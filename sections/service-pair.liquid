{%- comment -%} Zwei Spalten nebeneinander, zum Beispiel „Für wen" und „Warum". {%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom -%}

<section
  id="{{ s.anchor | default: 'fuer-wen' }}"
  data-outline="{{ s.outline_label | escape }}"
  class="chapter section-pad {% render 'scheme-classes', scheme: s.color_scheme %}{% if s.dots %} dots-bg{% endif %}"
>
  <div class="wrap pair-cols">
    {%- for block in section.blocks -%}
      <div class="pair-col" {{ block.shopify_attributes }}>
        {%- if block.settings.title != blank -%}<h2 class="ch-title">{{ block.settings.title }}</h2>{%- endif -%}
        {%- assign paras = block.settings.text | newline_to_br | split: '<br />' -%}
        {%- for p in paras -%}
          {%- assign t = p | strip -%}
          {%- if t != blank -%}<p class="ch-lead">{{ t }}</p>{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.service_pair.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "t:general.dots.label",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.service_pair.settings.anchor.label",
      "default": "fuer-wen"
    },
    {
      "type": "text",
      "id": "outline_label",
      "label": "t:general.outline_label.label",
      "default": "Für wen"
    },
    {
      "type": "header",
      "content": "t:sections.service_pair.settings.header_1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.service_pair.blocks.column.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.service_pair.blocks.column.settings.title.label",
          "default": "Für wen ist das sinnvoll?"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.service_pair.blocks.column.settings.text.label",
          "info": "t:sections.service_pair.blocks.column.settings.text.info",
          "default": "Für Unternehmen, die nachhaltig wachsen wollen."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.service_pair.presets.name",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ],
      "settings": {
        "color_scheme": "scheme-2"
      }
    }
  ]
}
{% endschema %}
