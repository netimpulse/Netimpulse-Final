{%- comment -%}
  Footer: Marke mit Kurztext, Menü, Leistungen mit Gruppenpunkten, Rechtliches, Copyright und „Nach oben".
{%- endcomment -%}
{%- liquid
  assign menu_1 = section.settings.menu_1
  assign year = 'now' | date: '%Y'

  assign services = nil
  for link in menu_1.links
    if link.links.size > 0
      assign services = link.links
      break
    endif
  endfor
-%}

{%- render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom, selector: '.site-footer', tablet: 64, mobile: 64 -%}

<footer class="site-footer color-{{ section.settings.color_scheme.id }}">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="logo" aria-label="{{ 'header.home_label' | t: shop: shop.name }}">
          <span class="logo-dot" aria-hidden="true"></span>
          <span class="logo-word">{{ section.settings.logo_text }}<span>{{ section.settings.logo_suffix }}</span></span>
        </a>
        {%- if section.settings.text != blank -%}
          <p class="t-small">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- if menu_1.links.size > 0 -%}
        <nav aria-label="{{ section.settings.heading_1 | escape }}" class="footer-col">
          <p class="footer-h">{{ section.settings.heading_1 }}</p>
          {%- for link in menu_1.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- if services.size > 0 -%}
        <nav aria-label="{{ section.settings.heading_2 | escape }}" class="footer-col">
          <p class="footer-h">{{ section.settings.heading_2 }}</p>
          {%- for link in services -%}
            <a href="{{ link.url }}" class="{% render 'group-class', name: link.title %}">
              {%- if section.settings.show_dots -%}<i class="svc-dot" aria-hidden="true"></i>{%- endif -%}
              {{ link.title }}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <nav aria-label="{{ section.settings.heading_3 | escape }}" class="footer-col">
        <p class="footer-h">{{ section.settings.heading_3 }}</p>
          {%- render 'policy-links', extra: section.settings.extra_page -%}
      </nav>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' and block.settings.menu.links.size > 0 -%}
          <nav aria-label="{{ block.settings.heading | escape }}" class="footer-col" {{ block.shopify_attributes }}>
            <p class="footer-h">{{ block.settings.heading }}</p>
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="footer-base">
      <span class="t-meta">{{ section.settings.copyright | replace: '[jahr]', year }}</span>
      {%- if section.settings.top_label != blank -%}
        <a href="#main" class="arrow-link" data-to-top>
          <span>{{ section.settings.top_label }}</span>
          {%- render 'icon', name: 'arrow-up', size: 16 -%}
        </a>
      {%- endif -%}
    </div>
  </div>
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
  {%- endfor -%}
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.color_scheme.label",
      "default": "scheme-4"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "t:sections.footer.settings.logo_text.label",
      "default": "NetImpulse"
    },
    {
      "type": "text",
      "id": "logo_suffix",
      "label": "t:sections.footer.settings.logo_suffix.label",
      "default": "marketing"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.footer.settings.text.label",
      "default": "Digitalagentur in Gießen für Shopify, Webdesign, SEO, GEO und Google Ads."
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_1.content"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "t:sections.footer.settings.heading_1.label",
      "default": "Menü"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "t:sections.footer.settings.menu_1.label",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_2.content"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "t:sections.footer.settings.heading_2.label",
      "default": "Leistungen"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.paragraph_1.content"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "t:sections.footer.settings.show_dots.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_3.content"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "t:sections.footer.settings.heading_3.label",
      "default": "Rechtliches"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.paragraph_2.content"
    },
    {
      "type": "page",
      "id": "extra_page",
      "label": "t:sections.footer.settings.extra_page.label",
      "info": "t:sections.footer.settings.extra_page.info"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_4.content"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "t:sections.footer.settings.copyright.label",
      "info": "t:sections.footer.settings.copyright.info",
      "default": "© [jahr] NetImpulse GbR"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "t:sections.footer.settings.top_label.label",
      "default": "Nach oben"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_5.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.menu.settings.heading.label",
          "default": "Mehr"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "default": "footer"
        }
      ]
    }
  ]
}
{% endschema %}
