{%- comment -%}
  Footer: Marke mit Kurztext, Menü, Leistungen mit Gruppenpunkten, Rechtliches, Copyright und „Nach oben".
{%- endcomment -%}
{%- liquid
  assign menu_1 = section.settings.menu_1
  assign menu_2 = section.settings.menu_2
  assign menu_3 = section.settings.menu_3
  assign year = 'now' | date: '%Y'

  assign services = menu_2.links
  if menu_2 == blank
    for link in menu_1.links
      if link.links.size > 0
        assign services = link.links
        break
      endif
    endfor
  endif
-%}

{%- render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom, selector: '.site-footer', tablet: 64, mobile: 64 -%}

<footer class="site-footer color-{{ section.settings.color_scheme.id }}">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="logo" aria-label="{{ 'header.home_label' | t: shop: shop.name }}">
          <span class="logo-dot" aria-hidden="true"></span>
          <span class="logo-word">{{ section.settings.logo_text }}<span>{{ section.settings.logo_suffix }}</span></span>
        </a>
        {%- if section.settings.text != blank -%}
          <p class="t-small">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- if menu_1.links.size > 0 -%}
        <nav aria-label="{{ section.settings.heading_1 | escape }}" class="footer-col">
          <p class="footer-h">{{ section.settings.heading_1 }}</p>
          {%- for link in menu_1.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      {%- if services.size > 0 -%}
        <nav aria-label="{{ section.settings.heading_2 | escape }}" class="footer-col">
          <p class="footer-h">{{ section.settings.heading_2 }}</p>
          {%- for link in services -%}
            <a href="{{ link.url }}" class="{% render 'group-class', name: link.title %}">
              {%- if section.settings.show_dots -%}<i class="svc-dot" aria-hidden="true"></i>{%- endif -%}
              {{ link.title }}
            </a>
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <nav aria-label="{{ section.settings.heading_3 | escape }}" class="footer-col">
        <p class="footer-h">{{ section.settings.heading_3 }}</p>
        {%- if menu_3.links.size > 0 -%}
          {%- for link in menu_3.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- if shop.legal_notice_policy != blank -%}<a href="{{ shop.legal_notice_policy.url }}">{{ shop.legal_notice_policy.title }}</a>{%- endif -%}
          {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
          {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
          {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
          {%- if section.settings.extra_page != blank -%}<a href="{{ section.settings.extra_page.url }}">{{ section.settings.extra_page.title }}</a>{%- endif -%}
        {%- endif -%}
      </nav>
    </div>
    <div class="footer-base">
      <span class="t-meta">{{ section.settings.copyright | replace: '[jahr]', year }}</span>
      {%- if section.settings.top_label != blank -%}
        <a href="#main" class="arrow-link" data-to-top>
          <span>{{ section.settings.top_label }}</span>
          {%- render 'icon', name: 'arrow-up', size: 16 -%}
        </a>
      {%- endif -%}
    </div>
  </div>
  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
  {%- endfor -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-4" },
    { "type": "text", "id": "logo_text", "label": "Wort-Logo", "default": "NetImpulse" },
    { "type": "text", "id": "logo_suffix", "label": "Wort-Logo Zusatz", "default": "marketing" },
    { "type": "textarea", "id": "text", "label": "Kurztext", "default": "Digitalagentur in Gießen für Shopify, Webdesign, SEO, GEO und Google Ads." },
    { "type": "header", "content": "Spalte 1" },
    { "type": "text", "id": "heading_1", "label": "Überschrift", "default": "Menü" },
    { "type": "link_list", "id": "menu_1", "label": "Menü", "default": "main-menu" },
    { "type": "header", "content": "Spalte 2" },
    { "type": "text", "id": "heading_2", "label": "Überschrift", "default": "Leistungen" },
    { "type": "link_list", "id": "menu_2", "label": "Menü", "info": "Ohne Auswahl: die Unterpunkte aus Spalte 1" },
    { "type": "checkbox", "id": "show_dots", "label": "Punkte in den Gruppenfarben zeigen", "default": true },
    { "type": "header", "content": "Spalte 3" },
    { "type": "text", "id": "heading_3", "label": "Überschrift", "default": "Rechtliches" },
    { "type": "link_list", "id": "menu_3", "label": "Menü", "info": "Ohne Auswahl: die Richtlinien aus Einstellungen > Richtlinien" },
    { "type": "page", "id": "extra_page", "label": "Zusätzliche Seite", "info": "Zum Beispiel Widerruf, solange keine Rückgaberichtlinie gepflegt ist" },
    { "type": "header", "content": "Unten" },
    { "type": "text", "id": "copyright", "label": "Copyright", "info": "[jahr] steht für das aktuelle Jahr", "default": "© [jahr] NetImpulse GbR" },
    { "type": "text", "id": "top_label", "label": "Nach oben", "default": "Nach oben" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
