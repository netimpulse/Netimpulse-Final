{%- comment -%} Passwortseite, solange der Shop geschützt ist. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom, selector: '.page-hero', tablet: 72, mobile: 40 -%}
<section class="page-hero {% render 'scheme-classes', scheme: s.color_scheme %}">
  <div class="wrap empty">
    <h1 class="t-h2">{{ s.title }}</h1>
    {%- if shop.password_message != blank -%}<p class="t-body">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'password-form' -%}
      <div class="field">
        <label for="pw">{{ 'general.password_label' | t }}</label>
        <input id="pw" type="password" name="password" autocomplete="current-password">
      </div>
      {{ form.errors | default_errors }}
      <button type="submit" class="btn btn-primary"><span>{{ 'general.password_submit' | t }}</span></button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Passwort",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Bald geöffnet" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
