{%- comment -%}
  Kopf der Leistungsübersicht: Text links, rechts das Rad als Navigation. Sobald das Rad aus dem Bild scrollt,
  dockt eine Leiste mit allen Leistungen unter dem Header an. Sprungziele: Kennung der Leistung (l-<kennung>).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'service'
  capture contact_url
    render 'contact-url'
  endcapture
-%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom, selector: '.l-hero', tablet: 64, mobile: 64 -%}

<section class="l-hero {% render 'scheme-classes', scheme: s.color_scheme %}{% if s.dots %} dots-bg{% endif %}" id="s-{{ section.id }}" data-outline="{{ s.outline_label | escape }}">
  <div class="wrap l-hero-grid">
    <div class="l-hero-copy">
      <h1 class="page-title">{{ s.title | default: page.title }}</h1>
      {%- if s.text != blank -%}<p class="ch-lead">{{ s.text }}</p>{%- endif -%}
      <div class="actions">
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_link | default: contact_url }}" class="btn btn-primary"><span>{{ s.button_label }}</span>{%- render 'icon', name: 'arrow-right' -%}</a>
        {%- endif -%}
        {%- if s.price_label != blank -%}
          <button type="button" class="btn btn-outline-light" data-scroll-to="{{ s.price_anchor }}">{{ s.price_label }}</button>
        {%- endif -%}
      </div>
    </div>
    <div class="l-orbit">
      {%- if items.size > 0 -%}
        {%- render 'orbit',
          items: items,
          detail: false,
          uid: section.id,
          label: s.orbit_label,
          group_1_label: s.group_1_label,
          group_2_label: s.group_2_label,
          pair_label: s.pair_label
        -%}
      {%- endif -%}
    </div>
    <leistungen-dock class="l-dock" aria-hidden="true">
      <div class="wrap">
        <nav class="l-dock-nav" aria-label="{{ s.dock_label | escape }}">
          {%- for block in items -%}
            <button type="button" tabindex="-1" class="l-dock-item{% render 'group-class', group: block.settings.group %}" data-scroll-to="l-{{ block.settings.key | handleize }}">{{ block.settings.name }}</button>
          {%- endfor -%}
          {%- if s.price_label != blank -%}
            <button type="button" tabindex="-1" class="l-dock-price" data-scroll-to="{{ s.price_anchor }}">{{ s.price_label }}</button>
          {%- endif -%}
        </nav>
      </div>
    </leistungen-dock>
  </div>
</section>

<script src="{{ 'sections.js' | asset_url }}" defer></script>

