{%- comment -%}
  Leistungs-Orbit mit Karten (Startseite): Das Rad dreht sich zur Karte in der Bildmitte,
  Partner-Leistungen sind gestrichelt verbunden.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'service'
-%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom -%}

<section
  id="s-{{ section.id }}"
  data-outline="{{ s.outline_label | escape }}"
  class="chapter section-pad {% render 'scheme-classes', scheme: s.color_scheme %}{% if s.dots %} dots-bg{% endif %}"
  {% if s.heading != blank %}aria-labelledby="svc-title-{{ section.id }}"{% endif %}
>
  <div class="wrap">
    <div class="sec-head">
      {%- if s.heading != blank -%}<h2 id="svc-title-{{ section.id }}" class="sec-title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="sec-lead">{{ s.text }}</p>{%- endif -%}
      {%- if s.link_label != blank -%}
        <a href="{{ s.link | default: '#' }}" class="arrow-link">
          <span>{{ s.link_label }}</span>
          {%- render 'icon', name: 'arrow-right', size: 16 -%}
        </a>
      {%- endif -%}
    </div>
    {%- if items.size > 0 -%}
      {%- render 'orbit',
        items: items,
        detail: true,
        uid: section.id,
        label: s.orbit_label,
        group_1_label: s.group_1_label,
        group_2_label: s.group_2_label,
        pair_label: s.pair_label
      -%}
    {%- endif -%}
  </div>
</section>

<script src="{{ 'sections.js' | asset_url }}" defer></script>

