{%- comment -%} Preiskarten, zum Beispiel „Zusatzleistungen rund um dein Theme". {%- endcomment -%}
{%- liquid
  assign s = section.settings
  capture contact_url
    render 'contact-url'
  endcapture
-%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom -%}

<section
  id="{{ s.anchor | default: 'zusatz' }}"
  data-outline="{{ s.outline_label | escape }}"
  class="chapter section-pad {% render 'scheme-classes', scheme: s.color_scheme %}{% if s.dots %} dots-bg{% endif %}"
  {% if s.heading != blank %}aria-labelledby="price-title-{{ section.id }}"{% endif %}
>
  <div class="wrap">
    <div class="ch-head">
      {%- if s.heading != blank -%}<h2 id="price-title-{{ section.id }}" class="ch-title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="ch-lead">{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="pricing">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign marked = b.highlight
          assign points = b.points | newline_to_br | split: '<br />'
        -%}
        <article class="price-card{% if marked %} is-marked{% endif %}" {{ block.shopify_attributes }}>
          <div class="price-top">
            <h3 class="t-h3">{{ b.name }}</h3>
            {%- if marked and b.note != blank -%}<span class="price-note">{{ b.note }}</span>{%- endif -%}
          </div>
          <p class="t-small">{{ b.text }}</p>
          <p class="price-value">{{ b.price }}</p>
          <ul class="checklist" role="list">
            {%- for pt in points -%}
              {%- assign t = pt | strip -%}
              {%- if t != blank -%}<li>{%- render 'icon', name: 'check', size: 16 -%}<span>{{ t }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if b.button_label != blank -%}
            <a href="{{ b.button_link | default: contact_url }}" class="btn {% if marked %}btn-primary{% else %}btn-secondary{% endif %} price-btn">
              <span>{{ b.button_label }}</span>{%- render 'icon', name: 'arrow-right' -%}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.pricing_cards.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "dots",
      "label": "t:general.dots.label",
      "default": false
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.pricing_cards.settings.anchor.label",
      "default": "zusatz"
    },
    {
      "type": "text",
      "id": "outline_label",
      "label": "t:general.outline_label.label",
      "default": "Zusatzleistungen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pricing_cards.settings.heading.label",
      "default": "Zusatzleistungen rund um dein Theme"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.pricing_cards.settings.text.label",
      "default": "Von einem schnellen Setup bis zu einem komplett individuellen Theme."
    },
    {
      "type": "header",
      "content": "t:sections.pricing_cards.settings.header_1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.pricing_cards.blocks.card.name",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.pricing_cards.blocks.card.settings.name.label",
          "default": "Theme-Setup"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.pricing_cards.blocks.card.settings.text.label",
          "default": "Für einen schnellen, sauberen Start"
        },
        {
          "type": "text",
          "id": "price",
          "label": "t:sections.pricing_cards.blocks.card.settings.price.label",
          "default": "ab 200 €"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "t:sections.pricing_cards.blocks.card.settings.highlight.label",
          "default": false
        },
        {
          "type": "text",
          "id": "note",
          "label": "t:sections.pricing_cards.blocks.card.settings.note.label",
          "info": "t:sections.pricing_cards.blocks.card.settings.note.info",
          "default": "Häufig gewählt"
        },
        {
          "type": "textarea",
          "id": "points",
          "label": "t:sections.pricing_cards.blocks.card.settings.points.label",
          "info": "t:sections.pricing_cards.blocks.card.settings.points.info",
          "default": "Theme-Installation\nGrundkonfiguration"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.pricing_cards.blocks.card.settings.button_label.label",
          "default": "Anfragen"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.pricing_cards.blocks.card.settings.button_link.label",
          "info": "t:sections.pricing_cards.blocks.card.settings.button_link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.pricing_cards.presets.name",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
