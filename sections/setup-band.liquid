{%- comment -%} Hinweis-Band, zum Beispiel „Lieber einrichten lassen?" unter dem Theme-Shop. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom -%}

<section class="section section-pad {% render 'scheme-classes', scheme: s.color_scheme %}" id="s-{{ section.id }}" data-outline="{{ s.outline_label | escape }}">
  <div class="wrap">
    <div class="setup-band">
      <div>
        {%- if s.heading != blank -%}<h2 class="t-h3">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="t-body">{{ s.text }}</p>{%- endif -%}
      </div>
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: '#' }}" class="btn btn-secondary"><span>{{ s.button_label }}</span>{%- render 'icon', name: 'arrow-right' -%}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.setup_band.name",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "outline_label",
      "label": "t:general.outline_label.label",
      "default": "Einrichtung"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.setup_band.settings.heading.label",
      "default": "Lieber einrichten lassen?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.setup_band.settings.text.label",
      "default": "Wir installieren dein Theme, übernehmen Logo und Farben und konfigurieren die Grundeinstellungen. Theme-Setup ab 200 €."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.setup_band.settings.button_label.label",
      "default": "Zusatzleistungen ansehen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.setup_band.settings.button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.setup_band.settings.header_1.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding_top.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding_bottom.label",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "t:sections.setup_band.presets.name"
    }
  ]
}
{% endschema %}
