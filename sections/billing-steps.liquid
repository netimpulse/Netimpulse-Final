{%- comment -%} „Wie wird abgerechnet?": Überschrift, Text und Button links, nummerierte Schritte rechts. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  capture contact_url
    render 'contact-url'
  endcapture
-%}
{%- render 'section-padding', id: section.id, top: s.padding_top, bottom: s.padding_bottom -%}

<section
  id="{{ s.anchor | default: 'abrechnung' }}"
  data-outline="{{ s.outline_label | escape }}"
  class="chapter billing-ch section-pad {% render 'scheme-classes', scheme: s.color_scheme %}{% if s.dots %} dots-bg{% endif %}"
  {% if s.heading != blank %}aria-labelledby="bill-title-{{ section.id }}"{% endif %}
>
  <div class="wrap">
    <div class="billing">
      <div class="billing-head">
        {%- if s.heading != blank -%}<h2 id="bill-title-{{ section.id }}" class="billing-title">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="billing-lead">{{ s.text }}</p>{%- endif -%}
        {%- if s.button_label != blank -%}
          <a href="{{ s.button_link | default: contact_url }}" class="btn btn-primary"><span>{{ s.button_label }}</span>{%- render 'icon', name: 'arrow-right' -%}</a>
        {%- endif -%}
      </div>
      <ol class="billing-steps" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="billing-n mono">{{ forloop.index }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Abrechnung in Schritten",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-2" },
    { "type": "checkbox", "id": "dots", "label": "Punktraster im Hintergrund", "default": true },
    { "type": "text", "id": "anchor", "label": "Sprungziel", "default": "abrechnung" },
    { "type": "text", "id": "outline_label", "label": "Name in der Sektions-Gliederung", "default": "Abrechnung" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wie wird abgerechnet?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Der Aufwand richtet sich nach der Größe deines Unternehmens, dem Umfang der Website und der Anzahl der Produkte." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Erstgespräch vereinbaren" },
    { "type": "url", "id": "button_link", "label": "Button-Link", "info": "Ohne Link: Kontaktseite" },
    { "type": "header", "content": "Abstände" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 100 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Kostenloses Erstgespräch" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Wir schauen gemeinsam, wo dein Auftritt steht und was er braucht." }
      ]
    }
  ],
  "presets": [{ "name": "Abrechnung in Schritten", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
