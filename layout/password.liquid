<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% unless settings.dark_mode %} data-theme="light"{% endunless %}>
  <head>
    {%- render 'meta-tags' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {%- render 'css-variables' -%}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="main" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
