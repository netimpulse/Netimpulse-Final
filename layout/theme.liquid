<!doctype html>
<html lang="{{ request.locale.iso_code }}"{% unless settings.dark_mode %} data-theme="light"{% endunless %}>
  <head>
    {%- render 'meta-tags' -%}
    {{ 'bricolage-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'work-sans-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {%- render 'css-variables' -%}
    <script>
      window.NI_SHOP = {
        moneyFormat: {{ shop.money_format | json }},
        cartUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        cartChangeUrl: {{ routes.cart_change_url | json }},
        cartUpdateUrl: {{ routes.cart_update_url | json }},
        predictiveUrl: {{ routes.predictive_search_url | json }},
        searchUrl: {{ routes.search_url | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip" href="#main">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}

    <main id="main" class="main" tabindex="-1">
      {%- if request.page_type == 'policy' -%}
        {%- render 'policy-frame', content: content_for_layout -%}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}

    {%- render 'cart-toast' -%}
    {%- if settings.show_outline -%}
      <outline-spy class="outline-spy" hidden>
        <nav aria-label="{{ 'accessibility.outline' | t }}">
          <p class="outline-spy-title">{{ settings.outline_title }}</p>
          <ul role="list"></ul>
        </nav>
      </outline-spy>
    {%- endif -%}
  </body>
</html>
