{%- comment -%}
  Platzhalter für eine Shop-Vorschau, solange kein Screenshot hinterlegt ist.
  Gleiche Struktur wie die Shop-Vorschau im Prototyp (Sektionen mit data-section), Texte als neutrale Balken.
  Parameter: device ('desktop' | 'mobile'), bg, fg, accent, alt (Farben, optional)
{%- endcomment -%}
{%- liquid
  assign d = device | default: 'desktop'
  assign c_bg = bg | default: '#F4F5F6'
  assign c_fg = fg | default: '#16191C'
  assign c_accent = accent | default: '#585B5F'
  assign c_alt = alt | default: ''
  if c_alt == blank
    assign c_alt = c_bg | color_mix: c_fg, 90
  endif
  assign c_muted = c_fg | color_mix: c_bg, 60
  assign c_surface = c_bg | color_mix: '#ffffff', 60
  assign c_line = c_fg | color_modify: 'alpha', 0.12
  assign c_line_strong = c_fg | color_modify: 'alpha', 0.24
  assign c_on_accent = '#ffffff'
  assign acc_b = c_accent | color_brightness
  if acc_b > 150
    assign c_on_accent = '#111418'
  endif
-%}
<div
  class="sf sf-{{ d }} sf-l-split sf-skel"
  aria-hidden="true"
  style="--s-bg: {{ c_bg }}; --s-fg: {{ c_fg }}; --s-muted: {{ c_muted }}; --s-surface: {{ c_surface }}; --s-alt: {{ c_alt }}; --s-accent: {{ c_accent }}; --s-on-accent: {{ c_on_accent }}; --s-line: {{ c_line }}; --s-line-strong: {{ c_line_strong }}; --s-display: var(--font-display); --s-body: var(--font-ui); --s-dw: 600; --s-wdth: 100%; --s-case: none; --s-track: -0.02em; --s-r: 8px;"
>
  <div class="sf-sec sf-announce" data-section="announcement"><span class="skl" style="--w: 16em; margin-inline: auto; opacity: .5"></span></div>
  <header class="sf-sec sf-header" data-section="header">
    <span class="sf-logo sf-h"><span class="skl" style="--w: 5.5em"></span></span>
    {%- if d != 'mobile' -%}
      <nav class="sf-nav"><span class="skl"></span><span class="skl"></span><span class="skl"></span><span class="skl"></span></nav>
    {%- endif -%}
    <span class="sf-icons">
      {%- render 'icon', name: 'search', size: 20 -%}
      {%- if d != 'mobile' -%}{%- render 'icon', name: 'user', size: 20 -%}{%- endif -%}
      {%- render 'icon', name: 'bag', size: 20 -%}
      {%- if d == 'mobile' -%}{%- render 'icon', name: 'menu', size: 20 -%}{%- endif -%}
    </span>
  </header>
  <section class="sf-sec sf-hero" data-section="hero">
    <div class="sf-hero-copy">
      <h1 class="sf-h"><span class="skl" style="--w: 92%"></span><span class="skl" style="--w: 78%"></span><span class="skl" style="--w: 64%"></span></h1>
      <p><span class="skl" style="--w: 90%"></span><span class="skl" style="--w: 70%; margin-top: .5em"></span></p>
      <div class="sf-actions"><span class="sf-btn"><span class="skl"></span></span><span class="sf-btn ghost"><span class="skl"></span></span></div>
    </div>
    <div class="sf-hero-art"></div>
  </section>
  <section class="sf-sec sf-collection" data-section="collection">
    <div class="sf-row-head">
      <h2 class="sf-h"><span class="skl" style="--w: 7em"></span></h2>
      <span class="sf-more"><span class="skl" style="--w: 4em"></span></span>
    </div>
    <div class="sf-grid">
      {%- for i in (1..4) -%}
        <div class="sf-card">
          <div class="sf-card-art"></div>
          <div class="sf-card-info"><span class="sf-card-name"><span class="skl" style="--w: 70%"></span></span><span class="sf-card-price"><span class="skl" style="--w: 40%"></span></span></div>
        </div>
      {%- endfor -%}
    </div>
  </section>
  <section class="sf-sec sf-feature" data-section="feature">
    <div class="sf-feature-art"></div>
    <div class="sf-feature-copy">
      <h2 class="sf-h"><span class="skl" style="--w: 9em"></span><span class="skl" style="--w: 6em"></span></h2>
      <p><span class="skl" style="--w: 18em"></span><span class="skl" style="--w: 13em; margin-top: .5em"></span></p>
      <span class="sf-btn ghost"><span class="skl"></span></span>
    </div>
  </section>
  <section class="sf-sec sf-news" data-section="newsletter">
    <h2 class="sf-h"><span class="skl" style="--w: 7em"></span></h2>
    <p><span class="skl" style="--w: 16em"></span></p>
    <div class="sf-news-form"><span class="sf-input"><span class="skl"></span></span><span class="sf-btn"><span class="skl"></span></span></div>
  </section>
  <footer class="sf-sec sf-footer" data-section="footer">
    <div class="sf-footer-cols">
      <div><span class="sf-logo sf-h"><span class="skl" style="--w: 5em"></span></span><p><span class="skl" style="--w: 8em"></span></p></div>
      <div><span class="skl"></span><span class="skl"></span><span class="skl"></span></div>
      <div><span class="skl"></span><span class="skl"></span><span class="skl"></span></div>
      <div><span class="skl"></span><span class="skl"></span></div>
    </div>
    <div class="sf-footer-base"><span class="skl" style="--w: 10em"></span></div>
  </footer>
</div>
