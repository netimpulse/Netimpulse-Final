{%- comment -%}
  Rahmen für die Shopify-Richtlinien (Impressum, Datenschutz, AGB, Widerruf): Navigation links,
  Inhaltsverzeichnis aus den Zwischenüberschriften, Text rechts. Der Text selbst kommt aus Einstellungen > Richtlinien.
  Parameter: content (content_for_layout)
{%- endcomment -%}
<section class="page-hero">
  <div class="wrap policy-grid">
    <aside class="toc" aria-label="{{ settings.legal_title | escape }}">
      <p class="field-label">{{ settings.legal_title }}</p>
      <nav class="toc-pages">
        {%- for policy in shop.policies -%}
          <a href="{{ policy.url }}"{% if request.path == policy.url %} aria-current="page"{% endif %}>{{ policy.title }}</a>
        {%- endfor -%}
        {%- if settings.legal_extra_page != blank -%}
          <a href="{{ settings.legal_extra_page.url }}"{% if request.path == settings.legal_extra_page.url %} aria-current="page"{% endif %}>{{ settings.legal_extra_page.title }}</a>
        {%- endif -%}
      </nav>
      <policy-toc data-title="{{ settings.legal_toc_title | escape }}"></policy-toc>
    </aside>
    <article class="prose policy-body">
      {{ content }}
    </article>
  </div>
</section>
<script src="{{ 'policy.js' | asset_url }}" defer></script>
