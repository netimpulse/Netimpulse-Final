{%- comment -%}
  Zusatzleistungen zum Dazubuchen (aus den Theme-Einstellungen). Auf der Produktseite und im Warenkorb.
  Parameter: prefix (eindeutige ID), compact, selected (Text mit den gewählten Namen, durch Komma getrennt)
{%- endcomment -%}
{%- liquid
  assign chosen = selected | default: '' | split: ','
-%}
<fieldset class="addons{% if compact %} is-compact{% endif %}">
  {%- if settings.addons_label != blank -%}<legend class="field-label">{{ settings.addons_label }}</legend>{%- endif -%}
  {%- for i in (1..3) -%}
    {%- liquid
      assign k_enabled = 'addon_' | append: i | append: '_enabled'
      assign k_name = 'addon_' | append: i | append: '_name'
      assign k_price = 'addon_' | append: i | append: '_price'
      assign k_text = 'addon_' | append: i | append: '_text'
      assign k_icon = 'addon_' | append: i | append: '_icon'
      assign k_product = 'addon_' | append: i | append: '_product'
      assign a_name = settings[k_name]
      assign a_product = settings[k_product]
      assign on = false
      for c in chosen
        assign cs = c | strip
        if cs == a_name
          assign on = true
        endif
      endfor
    -%}
    {%- if settings[k_enabled] and a_name != blank -%}
      {%- assign id = prefix | append: '-' | append: i -%}
      <label for="{{ id }}" class="addon{% if on %} is-on{% endif %}">
        <input
          id="{{ id }}"
          type="checkbox"
          data-addon="{{ i }}"
          data-name="{{ a_name | escape }}"
          data-price-label="{{ settings[k_price] | escape }}"
          {% if a_product != blank %}data-variant="{{ a_product.selected_or_first_available_variant.id }}"{% endif %}
          {% if on %}checked{% endif %}
        >
        <span class="addon-icon" aria-hidden="true">{%- render 'icon', name: settings[k_icon], size: 18 -%}</span>
        <span class="addon-text">
          <span class="addon-name">{{ a_name }}</span>
          <span class="addon-price">{{ settings[k_price] }}</span>
          {%- unless compact -%}<span class="addon-d">{{ settings[k_text] }}</span>{%- endunless -%}
        </span>
        <span class="addon-check" aria-hidden="true">{%- render 'icon', name: 'check', size: 16 -%}</span>
      </label>
    {%- endif -%}
  {%- endfor -%}
</fieldset>
